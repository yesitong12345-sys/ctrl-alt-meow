# Safe local account-mode example. Real secrets belong only in your .env.
HOST=127.0.0.1
PORT=4180
PORT_PROBE_LIMIT=1
AUTH_REQUIRED=1
CORS_ORIGIN=http://127.0.0.1:4180
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash
# Optional: set an installed Python executable path if automatic discovery fails.
# PYTHON_BIN=C:/Path/To/Python/python.exe
